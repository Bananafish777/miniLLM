      "options": {
        "orientation": "horizontal",
        "xField": "engine",
        "showValue": "auto",
        "legend": { "show": true, "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "max(minillm_bench_throughput_tps{concurrency=\"8\"}) by (engine, model)",
          "legendFormat": "{{ engine }} c=8",
          "refId": "A"
        },
        {
          "expr": "max(minillm_bench_throughput_tps{concurrency=\"32\"}) by (engine, model)",
          "legendFormat": "{{ engine }} c=32",
