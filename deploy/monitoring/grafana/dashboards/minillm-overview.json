{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "GPU 利用率 (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "GPU {{ $labels.uuid }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GPU 显存占用 (GB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "decbytes", "max": 90 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED / 1024 / 1024 / 1024",
          "legendFormat": "used {{ $labels.uuid }}",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_FB_TOTAL / 1024 / 1024 / 1024",
          "legendFormat": "total {{ $labels.uuid }}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "推理吞吐 (tokens/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "vLLM",
          "refId": "A"
        },
        {
          "expr": "sum(rate(minillm_tokens_generated_total[1m]))",
          "legendFormat": "minillm-hf",
          "refId": "B"
        }
      ]
    },
    {
      "title": "vLLM 运行/排队请求数",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "vllm:num_requests_running",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting",
          "refId": "B"
        }
      ]
    },
    {
      "title": "TTFT p50/p99 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vllm:time_to_first_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "vLLM p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vllm:time_to_first_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "vLLM p99",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(minillm_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "minillm-hf p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "KV Cache 命中率 & 使用率",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "vllm:cache_hit_rate * 100",
          "legendFormat": "prefix 命中率",
          "refId": "A"
        },
        {
          "expr": "vllm:gpu_cache_usage_perc * 100",
          "legendFormat": "cache 使用率",
          "refId": "B"
        }
      ]
    },
    {
      "title": "请求速率 (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(minillm_requests_total[1m]))",
          "legendFormat": "minillm-hf",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vllm:num_requests_total[1m]))",
          "legendFormat": "vLLM",
          "refId": "B"
        }
      ]
    },
    {
      "title": "GPU 温度 (℃)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "GPU {{ $labels.uuid }}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["minillm", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "miniLLM 全栈监控",
  "uid": "minillm-overview",
  "version": 1,
  "weekStart": ""
}
