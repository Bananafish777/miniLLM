# miniLLM Compose 环境变量模板 — 复制为 deploy/compose/.env 后按需修改
# HuggingFace 镜像（官方被墙时）
HF_ENDPOINT=https://hf-mirror.com

# 模型/配置
VLLM_MODEL=/models/runs/qwen25-1.5b-lora/export
SGLANG_MODEL=/models/runs/qwen25-1.5b-lora/export
TRAIN_CONFIG=configs/train/lora_qwen25_1p5b.yaml

# 推理服务端口
VLLM_PORT=8000
SGLANG_PORT=30000
SERVE_HF_PORT=8001

# vLLM 性能旋钮（Paged Attention / Continuous Batching / KV Cache）
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_NUM_SEQS=256
VLLM_MAX_BATCHED_TOKENS=8192
VLLM_PREFIX_CACHING=true

# GPU 数量（多卡张量并行）
VLLM_GPU_COUNT=1
SGLANG_GPU_COUNT=1
TRAIN_GPU_COUNT=1

# 监控端口与凭据
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
DCGM_PORT=9400
MLFLOW_PORT=5000
