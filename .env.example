# miniLLM environment template — copy to .env and adjust

# --- Logging ---
MINILLM_LOG_LEVEL=INFO

# --- HuggingFace ---
# 官方 hub 不可达时使用国内镜像
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=./data/cache/huggingface

# --- MLflow (可选，M1 起支持) ---
# MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
# MLFLOW_EXPERIMENT_NAME=minillm

# --- 推理服务（M2 使用）---
# VLLM_HOST=127.0.0.1
# VLLM_PORT=8000
# SGLANG_HOST=127.0.0.1
# SGLANG_PORT=30000
